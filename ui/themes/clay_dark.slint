// ui/themes/clay_dark.slint — Claymorphism Dark

import { AppTheme } from "tokens.slint";

export global ClayDarkTheme {
    public function apply() {
        // Backgrounds
        AppTheme.window-bg = #252836;
        AppTheme.toolbar-bg = #2b2f3f;
        AppTheme.editor-bg = #232633;
        AppTheme.sidebar-bg = #20232f;
        AppTheme.panel-bg = #2b2f3f;
        AppTheme.surface = #313547;
        AppTheme.surface-hover = #3a3f55;
        AppTheme.card-bg = #2f3345;
        AppTheme.card-active = #3a3f55;
        AppTheme.code-bg = #1c1f2a;
        AppTheme.input-bg = #1c1f2a;
        AppTheme.tab-bg = #2b2f3f;
        AppTheme.tab-active-bg = #3a3f55;

        // Text
        AppTheme.text-colour = #e0e5f0;
        AppTheme.text-muted = #98a0b8;
        AppTheme.text-strong = #ffffff;
        AppTheme.editor-text = #e0e5f0;
        AppTheme.editor-text-on-highlight = #1b1f2a;
        AppTheme.tooltip-text = #252836;
        AppTheme.tooltip-bg = #e0e5f0;
        AppTheme.caret-colour = #e0e5f0;
        AppTheme.selection-colour = #818cf860;

        // Accents
        AppTheme.accent-colour = #818cf8;
        AppTheme.accent-colour-2 = #a78bfa;
        AppTheme.accent-text = #171a24;
        AppTheme.danger-colour = #ff5c6c;
        AppTheme.success-colour = #34d399;
        AppTheme.warning-colour = #fbbf24;

        // Depth
        AppTheme.border-colour = #3d4257;
        AppTheme.shadow-colour = #12141c;
        AppTheme.shadow-light = #3d4257;
        AppTheme.shadow-dark = #12141c;
        AppTheme.depth = 1.0;

        // Shape
        AppTheme.radius-sm = 12px;
        AppTheme.radius-md = 16px;
        AppTheme.radius-lg = 20px;
        AppTheme.radius-xl = 26px;
        AppTheme.border-w = 2px;

        AppTheme.is-dark = true;
    }
}

// ui/themes/neu_dark.slint — Neumorphism Dark

import { AppTheme } from "tokens.slint";

export global NeuDarkTheme {
    public function apply() {
        // Backgrounds
        AppTheme.window-bg = #1f2229;
        AppTheme.toolbar-bg = #1f2229;
        AppTheme.editor-bg = #1f2229;
        AppTheme.sidebar-bg = #1f2229;
        AppTheme.panel-bg = #1f2229;
        AppTheme.surface = #262a33;
        AppTheme.surface-hover = #2e333e;
        AppTheme.card-bg = #242830;
        AppTheme.card-active = #2e333e;
        AppTheme.code-bg = #191c22;
        AppTheme.input-bg = #191c22;
        AppTheme.tab-bg = #1f2229;
        AppTheme.tab-active-bg = #2e333e;

        // Text
        AppTheme.text-colour = #c8d0e0;
        AppTheme.text-muted = #7c8798;
        AppTheme.text-strong = #eef2fa;
        AppTheme.editor-text = #c8d0e0;
        AppTheme.editor-text-on-highlight = #1b1f2a;
        AppTheme.tooltip-text = #1f2229;
        AppTheme.tooltip-bg = #c8d0e0;
        AppTheme.caret-colour = #c8d0e0;
        AppTheme.selection-colour = #818cf860;

        // Accents
        AppTheme.accent-colour = #818cf8;
        AppTheme.accent-colour-2 = #a78bfa;
        AppTheme.accent-text = #14161c;
        AppTheme.danger-colour = #ff5c6c;
        AppTheme.success-colour = #34d399;
        AppTheme.warning-colour = #fbbf24;

        // Depth
        AppTheme.border-colour = #1f222900;
        AppTheme.shadow-colour = #0d0f1340;
        AppTheme.shadow-light = #2c313b;
        AppTheme.shadow-dark = #0d0f13;
        AppTheme.depth = 1.0;

        // Shape
        AppTheme.radius-sm = 8px;
        AppTheme.radius-md = 12px;
        AppTheme.radius-lg = 18px;
        AppTheme.radius-xl = 16px;
        AppTheme.border-w = 0px;

        AppTheme.is-dark = true;
    }
}

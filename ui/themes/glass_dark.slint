// ui/themes/glass_dark.slint — Glassmorphism Dark
//
// Surfaces are translucent white laid over a near-black base. The real
// backdrop blur is not available on every Slint backend, so the panels fake
// depth with a translucent fill plus a light 1px rim. `GlassPanel` below is
// the reusable version of that recipe.

import { AppTheme } from "tokens.slint";

export global GlassDarkTheme {
    public function apply() {
        // Backgrounds
        AppTheme.window-bg = #0f1020;
        AppTheme.toolbar-bg = #ffffff18;
        AppTheme.editor-bg = #ffffff10;
        AppTheme.sidebar-bg = #ffffff12;
        AppTheme.panel-bg = #ffffff15;
        AppTheme.surface = #ffffff20;
        AppTheme.surface-hover = #ffffff30;
        AppTheme.card-bg = #ffffff14;
        AppTheme.card-active = #ffffff28;
        AppTheme.code-bg = #00000030;
        AppTheme.input-bg = #00000028;
        AppTheme.tab-bg = #ffffff14;
        AppTheme.tab-active-bg = #ffffff28;

        // Text
        AppTheme.text-colour = #f0f2ff;
        AppTheme.text-muted = #b0b8d0;
        AppTheme.text-strong = #ffffff;
        AppTheme.editor-text = #f0f2ff;
        AppTheme.editor-text-on-highlight = #1b1f2a;
        AppTheme.tooltip-text = #0f1020;
        AppTheme.tooltip-bg = #f0f2ff;
        AppTheme.caret-colour = #f0f2ff;
        AppTheme.selection-colour = #a78bfa50;

        // Accents
        AppTheme.accent-colour = #a78bfa;
        AppTheme.accent-colour-2 = #60a5fa;
        AppTheme.accent-text = #0f1020;
        AppTheme.danger-colour = #fb7185;
        AppTheme.success-colour = #34d399;
        AppTheme.warning-colour = #fcd34d;

        // Depth
        AppTheme.border-colour = #ffffff30;
        AppTheme.shadow-colour = #00000060;
        AppTheme.shadow-light = #ffffff28;
        AppTheme.shadow-dark = #00000050;
        AppTheme.depth = 0.5;

        // Shape
        AppTheme.radius-sm = 8px;
        AppTheme.radius-md = 14px;
        AppTheme.radius-lg = 20px;
        AppTheme.radius-xl = 18px;
        AppTheme.border-w = 1px;

        AppTheme.is-dark = true;
    }
}

/// Translucent panel with a light rim. Drop-in replacement for a plain
/// Rectangle anywhere a "frosted" surface is wanted.
export component GlassPanel inherits Rectangle {
    background: AppTheme.panel-bg;
    border-color: AppTheme.border-colour;
    border-width: AppTheme.border-w;
    border-radius: AppTheme.radius-lg;
}

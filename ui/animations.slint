// ui/animations.slint
//
// The motion layer. Everything here is pure Slint — no timers inside the UI.
//
// The liquid background is driven by a single `phase` property that the Rust
// side advances from a `slint::Timer`. Driving it from Rust rather than with
// `iteration-count: -1` means the drift stops the moment the user turns
// animations off, and it keeps the repaint cost at exactly 20 fps instead of
// every frame.

import { AppTheme } from "themes/tokens.slint";

// ── Liquid background ─────────────────────────────────────────────────────

export component LiquidBackground inherits Rectangle {
    // 0.0 .. 1.0, advanced by Rust. One full loop is one full turn.
    in property <float> phase: 0.0;
    in property <bool> motion-enabled: true;

    clip: true;
    visible: root.motion-enabled;
    background: transparent;

    property <float> tau: 6.28318530718;

    // Slint's trig takes angles; these wrap the float math in degrees.
    function sinf(v: float) -> float { return Math.sin(v * 1deg); }
    function cosf(v: float) -> float { return Math.cos(v * 1deg); }

    // Blob 1 — slowest drift, 32s at 20fps driver rate.
    Rectangle {
        width: 520px;
        height: 520px;
        x: -140px + root.sinf(root.phase * root.tau) * 170px;
        y: -160px + root.cosf(root.phase * root.tau) * 120px;
        border-radius: 230px + root.sinf(root.phase * root.tau * 2.0) * 46px;
        background: AppTheme.accent-colour.with-alpha(0.13);
    }

    // Blob 2 — counter-rotating, 27s.
    Rectangle {
        width: 440px;
        height: 440px;
        x: parent.width - 300px + root.cosf(root.phase * root.tau * 1.18) * 150px;
        y: parent.height - 380px + root.sinf(root.phase * root.tau * 1.18) * 130px;
        border-radius: 200px + root.cosf(root.phase * root.tau * 2.4) * 52px;
        background: AppTheme.accent-colour-2.with-alpha(0.11);
    }

    // Blob 3 — smallest, 36s, drifts vertically.
    Rectangle {
        width: 360px;
        height: 360px;
        x: parent.width / 2 - 180px + root.sinf(root.phase * root.tau * 0.83 + 1.7) * 190px;
        y: parent.height - 240px + root.cosf(root.phase * root.tau * 0.83 + 1.7) * 90px;
        border-radius: 168px + root.sinf(root.phase * root.tau * 1.6 + 0.9) * 38px;
        background: AppTheme.accent-colour.with-alpha(0.08);
    }
}

// ── Button with a press ripple ────────────────────────────────────────────

export component RippleButton inherits Rectangle {
    in property <string> label;
    in property <color> btn-colour: AppTheme.accent-colour;
    in property <color> label-colour: AppTheme.accent-text;
    in property <bool> enabled: true;
    in property <bool> emphasised: false;
    callback clicked();

    height: 32px;
    border-radius: AppTheme.radius-sm;
    background: root.enabled
        ? (touch.pressed ? root.btn-colour.darker(0.85) : root.btn-colour)
        : root.btn-colour.with-alpha(0.4);
    clip: true;
    opacity: root.enabled ? 1.0 : 0.6;

    animate background { duration: AppTheme.fast; easing: ease-out; }

    // Expanding ripple on release.
    Rectangle {
        width: parent.width * 2;
        height: parent.width * 2;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: #ffffff50;
        opacity: touch.pressed ? 0.5 : 0.0;
        animate opacity { duration: touch.pressed ? 0ms : 520ms; easing: ease-out; }
    }

    Text {
        text: root.label;
        color: root.label-colour;
        font-size: 13px;
        font-weight: root.emphasised ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── Quiet toolbar button (no fill) ────────────────────────────────────────

export component GhostButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> toggled: false;
    callback clicked();

    height: 28px;
    // `preferred-width` (not `width`) so callers may set `min-width` too.
    preferred-width: label-text.preferred-width + 16px;
    border-radius: AppTheme.radius-sm;
    border-width: root.toggled ? 1px : 0px;
    border-color: AppTheme.accent-colour;
    background: root.toggled
        ? AppTheme.accent-colour.with-alpha(0.18)
        : (ghost-touch.pressed ? AppTheme.surface-hover : (ghost-touch.has-hover ? AppTheme.surface : transparent));

    animate background { duration: AppTheme.fast; easing: ease-out; }

    label-text := Text {
        text: root.label;
        color: root.enabled
            ? (root.toggled ? AppTheme.text-strong : AppTheme.text-colour)
            : AppTheme.text-muted;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ghost-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── Toast ─────────────────────────────────────────────────────────────────

export component Toast inherits Rectangle {
    in property <string> message;

    // `visible` is inherited from Rectangle; the owner sets x, y, visible.
    opacity: root.visible ? 1.0 : 0.0;

    animate y { duration: 380ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    animate opacity { duration: 200ms; easing: ease-out; }

    height: toast-text.preferred-height + 20px;
    width: toast-text.preferred-width + 36px;
    border-radius: AppTheme.radius-md;
    background: AppTheme.tooltip-bg;

    toast-text := Text {
        text: root.message;
        color: AppTheme.tooltip-text;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

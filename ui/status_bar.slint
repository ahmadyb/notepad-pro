// ui/status_bar.slint
//
// All strings arrive pre-formatted from Rust (StatusData). Slint does no
// number-to-string conversion anywhere in this project — that keeps the
// formatting in one tested place instead of scattered through the markup.

import { AppTheme } from "themes/tokens.slint";
import { StatusData } from "model.slint";

export component StatusBar inherits Rectangle {
    in property <StatusData> status;

    height: AppTheme.statusbar-height;
    background: AppTheme.toolbar-bg;
    border-color: AppTheme.border-colour;
    clip: true;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 18px;
        alignment: start;

        Text {
            text: root.status.caret-text;
            font-size: 11px;
            color: AppTheme.text-muted;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        Text {
            text: root.status.metrics-text;
            font-size: 11px;
            color: AppTheme.text-muted;
            vertical-alignment: center;
        }

        if root.status.highlight-count > 0 : Text {
            text: root.status.highlight-text;
            font-size: 11px;
            color: AppTheme.accent-colour;
            vertical-alignment: center;
        }

        Text {
            text: root.status.zoom-text;
            font-size: 11px;
            color: AppTheme.text-muted;
            vertical-alignment: center;
        }

        Text {
            text: root.status.line-ending;
            font-size: 11px;
            color: AppTheme.text-muted;
            vertical-alignment: center;
        }

        Text {
            text: root.status.encoding;
            font-size: 11px;
            color: AppTheme.text-muted;
            vertical-alignment: center;
        }

        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: root.status.dirty ? AppTheme.warning-colour : AppTheme.success-colour;
            vertical-stretch: 0;
            animate background { duration: AppTheme.fast; }
        }

        Text {
            text: root.status.saved-text;
            font-size: 11px;
            color: root.status.dirty ? AppTheme.warning-colour : AppTheme.success-colour;
            vertical-alignment: center;
        }
    }
}
